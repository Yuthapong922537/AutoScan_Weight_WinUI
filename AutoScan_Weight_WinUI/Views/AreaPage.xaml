<?xml version="1.0" encoding="utf-8"?>
<Page 
x:Class="AutoScan_Weight_WinUI.Views.AreaPage" 
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
xmlns:local="using:AutoScan_Weight_WinUI.Views" 
xmlns:converter="using:AutoScan_Weight_WinUI.Helps" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:vm="using:AutoScan_Weight_WinUI.ViewModels" mc:Ignorable="d"
xmlns:control="using:CommunityToolkit.WinUI.UI.Controls"
xmlns:controls="using:AutoScan_Weight_WinUI.Views.Controls">

    <!--<Page.DataContext>
         <vm:AreaViewModel/>
    </Page.DataContext>-->

    <Page.Resources>
        <Style x:Key="MyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF6115"/>
            <Setter Property="Foreground" Value="#FFFCF4"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="MyBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#18251D"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="MyTextSytle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B7FF72"/>
        </Style>

        <converter:PlaceStatusRowColorConverter
            x:Key="PlaceStatusRowColorConverter"/>
    </Page.Resources>


    <Grid Background="#18251D">
            
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*" />
            
            <ColumnDefinition Width="650"/>

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MyBorderStyle}">

            <TextBlock
                     Text="Warehouse Management System"
                     FontSize="50"
                     FontWeight="Bold"
                     Margin="20,0,0,0"
                     Style="{StaticResource MyTextSytle}"/>          

        </Border>



        <Border Grid.Row="1" Grid.Column="0" CornerRadius="8" Background="#18251D" x:Name="RootBorder" AllowDrop="True" DragOver="RootBorder_DragOver" Drop="RootBorder_Drop">


            <Canvas x:Name="AreaCanvas">

                <TextBlock
                    Text="Warehouse (ZONE A)"
                    Canvas.Left="200"
                    Canvas.Top="0"
                    FontSize="24"
                    FontWeight="Bold"
                    Style="{StaticResource MyTextSytle}"/>

                <TextBlock
                    Text="ZONE B"
                    Canvas.Left="250"
                    Canvas.Top="180"
                    FontSize="24"
                    FontWeight="Bold"
                    Style="{StaticResource MyTextSytle}"/>

                <TextBlock
                    Text="ZONE C"
                    Canvas.Left="250"
                    Canvas.Top="350"
                    FontSize="24"
                    FontWeight="Bold"
                    Style="{StaticResource MyTextSytle}"/>

                <TextBlock
                     Text="ZONE D"
                     Canvas.Left="250"
                     Canvas.Top="520"
                     FontSize="24"
                     FontWeight="Bold"
                     Style="{StaticResource MyTextSytle}"/>

                <TextBlock
                     Text="ZONE E"
                     Canvas.Left="250"
                     Canvas.Top="690"
                     FontSize="24"
                     FontWeight="Bold"
                     Style="{StaticResource MyTextSytle}"/>

                <TextBlock
                     Text="ZONE G"
                     Canvas.Left="620"
                     Canvas.Top="180"
                     FontSize="24"
                     FontWeight="Bold"
                     Style="{StaticResource MyTextSytle}"/>

                <TextBlock
                     Text="ZONE F"
                     Canvas.Left="620"
                     Canvas.Top="350"
                     FontSize="24"
                     FontWeight="Bold"
                     Style="{StaticResource MyTextSytle}"/>

                <TextBlock
                     Text="Warehouse2 (Zone H)"
                     Canvas.Left="890"
                     Canvas.Top="180"
                     FontSize="24"
                     FontWeight="Bold"
                     Style="{StaticResource MyTextSytle}"/>

                <TextBlock
                     Text="Warehouse3 (Zone I)"
                     Canvas.Left="900"
                     Canvas.Top="520"
                     FontSize="24"
                     FontWeight="Bold"
                     Style="{StaticResource MyTextSytle}"/>

                <!--<AutoSuggestBox
                    Width="250"
                    PlaceholderText="Search Pallet / Area"
                    Text="{Binding SearchText,Mode=TwoWay}"
                    Canvas.Left="750"
                    Canvas.Top="20"/>-->

                <ComboBox Width="150"
                     
                      x:Name="SearchComboBox"
                      CornerRadius="12"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      HorizontalAlignment="Stretch"                                   
                      PlaceholderText="-- กรุณาเลือก --"  
                      ItemsSource="{Binding SearchText}"
                      SelectedItem="{Binding SelectedSearchText,Mode=TwoWay}"
                      Canvas.Left="550"
                      Canvas.Top="20">
                    <ComboBox.Header>
                        <TextBlock Text="Order"
                        Style="{StaticResource MyTextSytle}"
                        FontWeight="SemiBold"
                       FontSize="18"/>
                    </ComboBox.Header>
                </ComboBox>

                <ComboBox Width="150"
                       
                       x:Name="DocNoComboBox"
                       CornerRadius="12"
                       IsEditable="True"
                       IsTextSearchEnabled="True"
                       HorizontalAlignment="Stretch"                                   
                       PlaceholderText="-- กรุณาเลือก --"  
                       ItemsSource="{Binding DocNoCombo}"
                       SelectedItem="{Binding SelectedDocNo,Mode=TwoWay}"
                       Canvas.Left="700"
                       Canvas.Top="20">
                    <ComboBox.Header>
                        <TextBlock Text="DocNo"
                            Style="{StaticResource MyTextSytle}"
                            FontWeight="SemiBold"
                           FontSize="18"/>
                    </ComboBox.Header>
                </ComboBox>

                <ComboBox Width="150"
                           
                           x:Name="FinalComboBox"
                           CornerRadius="12"
                           IsEditable="True"
                           IsTextSearchEnabled="True"
                           HorizontalAlignment="Stretch"                                   
                           PlaceholderText="-- กรุณาเลือก --"  
                           ItemsSource="{Binding FinalCombo}"
                           SelectedItem="{Binding SelectedFinal,Mode=TwoWay}"
                           Canvas.Left="850"
                           Canvas.Top="20">
                    <ComboBox.Header>
                        <TextBlock Text="FinalDest"
                            Style="{StaticResource MyTextSytle}"
                            FontWeight="SemiBold"
                           FontSize="18"/>
                    </ComboBox.Header>
                </ComboBox>

                <ComboBox Width="150"
                            
                            x:Name="CartonsComboBox"
                            CornerRadius="12"
                            IsEditable="True"
                            IsTextSearchEnabled="True"
                            HorizontalAlignment="Stretch"                                   
                            PlaceholderText="-- กรุณาเลือก --"  
                            ItemsSource="{Binding CartonCombo}"
                            SelectedItem="{Binding SelectedCartons,Mode=TwoWay}"
                            Canvas.Left="1000"
                            Canvas.Top="20">
                    <ComboBox.Header>
                        <TextBlock Text="Carton"
                            Style="{StaticResource MyTextSytle}"
                            FontWeight="SemiBold"
                           FontSize="18"/>
                    </ComboBox.Header>
                </ComboBox>

                <ComboBox Width="200"            
                             x:Name="PackingListComboBox"
                             CornerRadius="12"
                             IsEditable="True"
                             IsTextSearchEnabled="True"
                             HorizontalAlignment="Stretch"                                   
                             PlaceholderText="-- กรุณาเลือก --"  
                             ItemsSource="{Binding PackingListCombo}"
                             SelectedItem="{Binding SelectedPackingList,Mode=TwoWay}"
                             Canvas.Left="550"
                             Canvas.Top="90">
                    <ComboBox.Header>
                        <TextBlock Text="PackingList"
                                     Style="{StaticResource MyTextSytle}"
                                     FontWeight="SemiBold"
                                    FontSize="18"/>
                    </ComboBox.Header>
                </ComboBox>

                <ComboBox Width="150"            
                             x:Name="GroupTypeComboBox"
                             CornerRadius="12"
                             IsEditable="True"
                             IsTextSearchEnabled="True"
                             HorizontalAlignment="Stretch"                                   
                             PlaceholderText="-- กรุณาเลือก --"  
                             ItemsSource="{Binding GroupTypeCombo}"
                             SelectedItem="{Binding SelectedGroupType,Mode=TwoWay}"
                             Canvas.Left="750"
                             Canvas.Top="90">
                    <ComboBox.Header>
                        <TextBlock Text="GroupType"
                             Style="{StaticResource MyTextSytle}"
                             FontWeight="SemiBold"
                            FontSize="18"/>
                    </ComboBox.Header>
                </ComboBox>



                <!--<Button
                    Content="Search"
                    Command="{Binding SearchCommand}"
                    Canvas.Left="1010"
                    Canvas.Top="20"/>-->

                <Button
                    Content="Clear"
                    Command="{Binding ClearSearchCommand}"
                    Canvas.Left="1150"
                    Canvas.Top="52"
                    Style="{StaticResource MyButtonStyle}"/>

                <Line Stroke="#B7FF72"
                      X1="0" Y1="0"
                      X2="250" Y2="0"
                      StrokeThickness="5"
                      Canvas.Left="550"
                      Canvas.Top="560"/>

                <Line Stroke="#B7FF72"
                      X1="0" Y1="0"
                      X2="250" Y2="0"
                      StrokeThickness="5"
                      Canvas.Left="550"
                      Canvas.Top="800"/>

                <TextBlock Text="Status" 
                           FontSize="24" 
                           Style="{StaticResource MyTextSytle}" 
                           FontWeight="Bold"
                           Canvas.Left="550"
                           Canvas.Top="570"/>

                <Ellipse Width="20" 
                         Height="20"
                         Canvas.Left="550"
                         Canvas.Top="620"
                         Fill="Yellow"
                         Stroke="Yellow"
                         StrokeThickness="2"/>

                <TextBlock Text="Open" 
                           FontSize="24" 
                           Style="{StaticResource MyTextSytle}" 
                           FontWeight="Bold"
                           Canvas.Left="590"
                           Canvas.Top="610"/>

                <Ellipse Width="20" 
                         Height="20"
                         Canvas.Left="550"
                         Canvas.Top="660"
                         Fill="IndianRed"
                         Stroke="IndianRed"
                         StrokeThickness="2"/>

                <TextBlock Text="Full" 
                             FontSize="24" 
                             Style="{StaticResource MyTextSytle}" 
                             FontWeight="Bold"
                             Canvas.Left="590"
                             Canvas.Top="650"/>

                <Ellipse Width="20" 
                         Height="20"
                         Canvas.Left="550"
                         Canvas.Top="740" 
                         Fill="Orange"
                         Stroke="Orange"
                         StrokeThickness="2"/>

                <TextBlock Text="Close" 
                             FontSize="24" 
                             Style="{StaticResource MyTextSytle}" 
                             FontWeight="Bold"
                             Canvas.Left="590"
                             Canvas.Top="730"/>

                <Ellipse Width="20" 
                          Height="20"
                          Canvas.Left="550"
                          Canvas.Top="700" 
                          Fill="#50545D"
                          Stroke="#50545D"
                          StrokeThickness="2"/>

                <TextBlock Text="Empty" 
                             FontSize="24" 
                             Style="{StaticResource MyTextSytle}" 
                             FontWeight="Bold"
                             Canvas.Left="590"
                             Canvas.Top="690"/>
                
                <Rectangle  x:Name="MyRectangle"
                            Width="400" 
                           Height="700" 
                           Fill="#18251D"
                           Canvas.Left="800"
                           Canvas.Top="170"
                           Canvas.ZIndex="1"
                           Visibility="{Binding RectangleVisibility}"/>

                
                    <ToggleSwitch  OffContent="Show WH 2,3" OnContent="Hide WH 2,3" IsOn="true" 
                                    Canvas.Left="1080"
                                    Canvas.Top="130"
                                   Toggled="RectangleToggle_Toggled"
                                    x:Name="RectangleToggle"/>

                <Button
                            Content="Update Invoice"
                            Command="{Binding InvoicCommand}"
                            Canvas.Left="1090"
                            Canvas.Top="100"
                            Style="{StaticResource MyButtonStyle}"/>

            </Canvas>  
            
        </Border>

        <Grid Grid.Column="2" Grid.Row="1" >

            <Grid.RowDefinitions>
                <RowDefinition Height="160"/>
                <RowDefinition Height="600"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource MyBorderStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="*"/>
                        

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8" Orientation="Vertical" Margin="20,0,0,0">

                    <TextBlock
                             Text="Pallet Detail"
                             FontSize="22"
                             FontWeight="Bold"
                             Style="{StaticResource MyTextSytle}"/>

                        <TextBlock Style="{StaticResource MyTextSytle}">
                         <Run Text="Area : " FontSize="18"  />
                         <Run Text="{Binding SelectedArea.AreaName}" FontSize="18" />
                    </TextBlock>

                        <TextBlock Style="{StaticResource MyTextSytle}">
                         <Run Text="Pallet : " FontSize="18" />
                         <Run Text="{Binding SelectedArea.PalletsNo}" FontSize="18" />
                    </TextBlock>

                        <TextBlock Style="{StaticResource MyTextSytle}">
                           <Run Text="Customer : " FontSize="18" />
                           <Run Text="{Binding Customer}" FontSize="18"/>
                        </TextBlock>



                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8" Orientation="Vertical" Margin="20,8,0,0">

                        <TextBlock Style="{StaticResource MyTextSytle}">
                                      <Run Text="WareHouse : " FontSize="18"/>
                                      <Run Text="{Binding SelectedArea.WarehouseName}" FontSize="18" />     
                        </TextBlock>

                        <TextBlock Style="{StaticResource MyTextSytle}">
                              <Run Text="GroupKey : " FontSize="18" />
                              <Run Text="{Binding SelectedArea.GroupKey}" FontSize="18" /> 
                        </TextBlock>

                        <TextBlock Style="{StaticResource MyTextSytle}">
                              <Run Text="GroupType : " FontSize="18" />
                              <Run Text="{Binding SelectedArea.GroupType}" FontSize="18" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource MyTextSytle}">
                              <Run Text="Already : " FontSize="18" />
                              <Run Text="{Binding Already}" FontSize="18" />
                        </TextBlock>


                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="8" Orientation="Vertical" Margin="20,8,0,0">

                        <TextBlock Style="{StaticResource MyTextSytle}">
                             <Run Text="CartonCount : " FontSize="18" />
                             <Run Text="{Binding SelectedArea.CartonCount}" FontSize="18"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource MyTextSytle}">
                             <Run Text="MaxCapacity : " FontSize="18" />
                             <Run Text="{Binding SelectedArea.MaxCapital}" FontSize="18" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource MyTextSytle}">
                             <Run Text="Pallet Status : " FontSize="18" />
                             <Run Text="{Binding SelectedArea.PalletStatus}" FontSize="18" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource MyTextSytle}">
                               <Run Text="Remaining : " FontSize="18" />
                               <Run Text="{Binding Remaining}" FontSize="18" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource MyTextSytle}">
                                <Run Text="Item Qty : " FontSize="18" />
                                <Run Text="{Binding AllQty}" FontSize="18" />
                        </TextBlock>

                    </StackPanel>

                </Grid>
            </Border>

            <Border Grid.Row="1"
                     Margin="10"
                     Padding="15"
                     Style="{StaticResource MyBorderStyle}"
                     CornerRadius="8">
                <StackPanel>
                    
                
            <control:DataGrid
                        x:Name="DataInformation"
                        Height="520"
                        RowHeight="10"
                        FontSize="12"
                        AutoGenerateColumns="False"
                        CornerRadius="12"
                        SelectionMode="Single"
                        BorderThickness="1"
                        ItemsSource="{Binding DataPallet}"
                        Background="#FFFCF4"
                        Foreground="{ThemeResource CardBackgroundFillColorSecondary}"
                        LoadingRow="DataInformation_LoadingRow">



                <control:DataGrid.Resources>
                            <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundColor" Color="{ThemeResource CardBackgroundFillColorSecondary}" />
                </control:DataGrid.Resources>

                   
                <control:DataGrid.CellStyle>
                    <Style TargetType="control:DataGridCell">
                                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondary}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                            
                        </Style>


                </control:DataGrid.CellStyle>

                <control:DataGrid.Columns>

                    <!--<control:DataGridTextColumn
                                Header="PalletID"
                                Width="auto"                                      
                                Binding="{Binding PalletID}"/>-->


                    <!--<control:DataGridTextColumn
                                Header="PalletNo"
                                Width="auto"
                                Binding="{Binding PalletNo}"/>-->


                    <control:DataGridTextColumn
                                Header="DocNo"
                                Width="auto"
                                Binding="{Binding DocNo}"
                                Foreground="Black"/>


                    <!--<control:DataGridTextColumn
                                Header="StyleID"
                                Width="auto"
                                Binding="{Binding StyleID}"/>-->

                    <control:DataGridTextColumn
                                Header="OrderNo"
                                Width="auto"
                                Binding="{Binding OrderNo}"
                                Foreground="Black"/>

                    <!--<control:DataGridTextColumn
                                Header="Style"
                                Width="auto"
                                Binding="{Binding Style}"/>-->

                    <!--<control:DataGridTextColumn
                                Header="CustPORef"
                                Width="auto"
                                Binding="{Binding CustPORef}"/>-->

                    <!--<control:DataGridTextColumn
                                Header="LotRef"
                                Width="auto"
                                Binding="{Binding LotRef}"/>-->

                    <control:DataGridTextColumn
                                Header="Final"
                                Width="60"
                                Binding="{Binding FinalDest}"
                                Foreground="Black"/>

                    <!--<control:DataGridTextColumn
                                Header="Warehouse"
                                Width="auto"
                                Binding="{Binding Warehouse}"/>-->

                    <control:DataGridTextColumn
                                Header="BarcodeCarton"
                                Width="auto"
                                Binding="{Binding BarcodeCarton}"
                                Foreground="Black"/>

                    <control:DataGridTextColumn
                                Header="carton"
                                Width="80"
                                Binding="{Binding Scancarton}"
                                Foreground="Black"/>

                    <!--<control:DataGridTextColumn
                                Header="InvoiceNo"
                                Width="auto"
                                Binding="{Binding InvoiceNo}"/>-->

                    <control:DataGridTextColumn
                                Header="Customer"
                                Width="auto"
                                Binding="{Binding Customer}"
                                Foreground="Black"/>
                   

                        <control:DataGridTextColumn
                                Header="PlaceStatus"
                                Width="auto"
                                Binding="{Binding PlaceStatus}"
                                Foreground="Black"/>

                            <control:DataGridTextColumn
                                Header="Qty"
                                Width="auto"
                                Binding="{Binding Qty}"
                                Foreground="Black"/>

                            <!--<control:DataGridTextColumn
                                Header="SeqlnPallet"
                                Width="auto"
                                Binding="{Binding SeqlnPallet}"/>-->

                    <!--<control:DataGridTextColumn
                                Header="PlaceStatus"
                                Width="auto"
                                Binding="{Binding PlaceStatus}"/>-->

                    <!--<control:DataGridTextColumn
                                Header="CreateDate"
                                Width="auto"
                                Binding="{Binding CreateDate}"/>-->

                </control:DataGrid.Columns>

            </control:DataGrid>

                    <Button Content="Export" 
                            FontWeight="Bold"
                            Command="{Binding ExportCommand}"
                            VerticalAlignment="Center"                            
                            Width="100"
                            Height="30"
                            Margin="500,0,0,0"
                            Style="{StaticResource MyButtonStyle}"/>

                </StackPanel>

            </Border>

            <Grid Grid.Row="2">
                
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource MyBorderStyle}">

                        <TextBlock
                                 Text="Optimize Cartons"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 Margin="20,0,0,0"
                                 Style="{StaticResource MyTextSytle}"/>    

                </Border>

                <Border Grid.Row="1" Style="{StaticResource MyBorderStyle}">

                    <StackPanel  Spacing="8" Orientation="Horizontal" Margin="50,0,0,0" HorizontalAlignment="Left">

                        <ComboBox Width="150"
                                  
                                  x:Name="CartonComboBox"
                                  CornerRadius="12"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  HorizontalAlignment="Stretch"                                   
                                  PlaceholderText="-- กรุณาเลือก --"  
                                  ItemsSource="{Binding Carton}"
                                  SelectedItem="{Binding SelectedCarton,Mode=TwoWay}">

                            <ComboBox.Header>
                                <TextBlock Text="Cartons"
                                    Style="{StaticResource MyTextSytle}"
                                    FontWeight="SemiBold"
                                   FontSize="18"/>
                            </ComboBox.Header>
                        </ComboBox>

                        <ComboBox Width="150"
                                  
                                  x:Name="PalletComboBox"
                                  
                                  CornerRadius="12"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  HorizontalAlignment="Stretch"                                   
                                  PlaceholderText="-- กรุณาเลือก --"  
                                  ItemsSource="{Binding Pallets}"
                                  SelectedItem="{Binding SelectedPallet,Mode=TwoWay}">

                            <ComboBox.Header>
                                <TextBlock Text="Pallets"
                                    Style="{StaticResource MyTextSytle}"
                                    FontWeight="SemiBold"
                                   FontSize="18"/>
                            </ComboBox.Header>
                        </ComboBox>

                   
                            <Button Content="Save" 
                                    FontWeight="Bold"
                                    Command="{Binding ChangeCommand}"
                                    VerticalAlignment="Center"
                                    Width="100"
                                    Height="40"
                                    Margin="50,0,0,0"
                                    Style="{StaticResource MyButtonStyle}"/>
                            
                    </StackPanel>

                </Border>

                <Border Grid.Row="2" Style="{StaticResource MyBorderStyle}">

                    <TextBlock Text="{Binding TextChangePallet}" FontSize="18" FontWeight="Bold" Margin="0,0,0,0" Foreground="#FFB7A5"/>

                </Border>

            </Grid>
           
        </Grid>




    </Grid>



</Page>