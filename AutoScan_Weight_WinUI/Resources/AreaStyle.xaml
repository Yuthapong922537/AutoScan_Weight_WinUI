<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--xmlns:local="using:AutoScan_Weight_WinUI.Resources">-->

    <!--============================-->
    <!-- Area Size                  -->
    <!--============================-->

    <x:Double x:Key="AreaWidth">60</x:Double>
    <x:Double x:Key="AreaHeight">60</x:Double>

    <Thickness x:Key="AreaMargin">4</Thickness>

    <CornerRadius x:Key="AreaCornerRadius">6</CornerRadius>

    <!--============================-->
    <!-- Brushes                    -->
    <!--============================-->

    <SolidColorBrush x:Key="AreaEmptyBrush"
                     Color="#3B3F45"/>

    <SolidColorBrush x:Key="AreaOccupiedBrush"
                     Color="#1E88E5"/>

    <SolidColorBrush x:Key="AreaSelectedBrush"
                     Color="#00C853"/>

    <SolidColorBrush x:Key="AreaAlarmBrush"
                     Color="#E53935"/>

    <SolidColorBrush x:Key="AreaBorderBrush"
                     Color="#666666"/>

    <SolidColorBrush x:Key="AreaTextBrush"
                     Color="White"/>
    
    <SolidColorBrush x:Key="AreaDropBrush"
                 Color="#FF9800"/>

    <SolidColorBrush x:Key="AreaHighlightBrush"
                 Color="LimeGreen"/>

</ResourceDictionary>
